---
import { Image, PortableText } from "emdash/ui";
interface Props {
	title?: string | null;
	body?: any[] | null;
	image?: any;
	reverse?: boolean;
}
const { title, body, image, reverse = false } = Astro.props;
---

{(body?.length || title) && (
	<div class:list={["split", { reverse, "no-image": !image }]}>
		<div class="copy">
			{title && <h2>{title}</h2>}
			{body && <div class="prose"><PortableText value={body} /></div>}
			<slot />
		</div>
		{image && (
			<div class="media"><Image image={image} sizes="(max-width: 860px) 100vw, 40vw" /></div>
		)}
	</div>
)}

<style>
	.split { display: grid; grid-template-columns: 1.2fr 1fr; gap: clamp(2rem, 6vw, 5rem); align-items: start; }
	.split.reverse .media { order: -1; }
	.split.no-image { grid-template-columns: 1fr; }
	h2 { font-size: var(--step-3); font-weight: 300; letter-spacing: -0.02em; color: var(--pine); margin-bottom: 1.5rem; }
	.media {
		position: sticky;
		top: 100px;
		border-radius: 140px var(--radius-lg) var(--radius-lg) var(--radius-lg);
		overflow: hidden;
		aspect-ratio: 1 / 1;
		background: var(--mist);
	}
	.media :global(img) { width: 100%; height: 100%; object-fit: cover; }
	@media (max-width: 860px) {
		.split { grid-template-columns: 1fr; }
		.media { position: static; order: -1; aspect-ratio: 16 / 10; }
	}
</style>
