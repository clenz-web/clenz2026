---
import { Image } from "emdash/ui";
import { SITE } from "../site";

interface Props {
	treatments: any[];
	bookLabel: string;
}
const { treatments, bookLabel } = Astro.props;
---

<ul class="menu">
	{treatments.map((tr) => (
		<li class="row">
			{tr.data.image && (
				<div class="thumb"><Image image={tr.data.image} sizes="96px" /></div>
			)}
			<div class="info">
				<h3>{tr.data.title}</h3>
				{tr.data.summary && <p>{tr.data.summary}</p>}
				<ul class="prices">
					{String(tr.data.prices).split("|").map((p: string) => <li>{p.trim()}</li>)}
				</ul>
			</div>
			<a class="book" href={SITE.bookingUrl} target="_blank" rel="noopener">
				{bookLabel}<span class="visually-hidden">: {tr.data.title}</span>
			</a>
		</li>
	))}
</ul>

<style>
	.menu { list-style: none; border-top: 1px solid var(--line); }
	.row {
		display: grid;
		grid-template-columns: 96px 1fr auto;
		gap: 1.25rem 1.5rem;
		align-items: center;
		padding-block: 1.4rem;
		border-bottom: 1px solid var(--line);
	}
	.thumb {
		width: 96px;
		height: 96px;
		border-radius: 50%;
		overflow: hidden;
		background: var(--mist);
	}
	.thumb :global(img) { width: 100%; height: 100%; object-fit: cover; }
	h3 { font-size: var(--step-1); font-weight: 400; color: var(--pine); }
	.info p { color: var(--stone); margin-top: 0.2rem; }
	.prices {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		margin-top: 0.7rem;
	}
	.prices li {
		font-size: var(--step--1);
		padding: 0.25rem 0.7rem;
		border-radius: var(--pill);
		background: var(--white);
		border: 1px solid var(--line);
		font-variant-numeric: tabular-nums;
	}
	.book {
		font-weight: 500;
		color: var(--pine);
		text-underline-offset: 4px;
		white-space: nowrap;
		padding: 0.6rem 0;
	}
	@media (max-width: 640px) {
		.row { grid-template-columns: 64px 1fr; }
		.thumb { width: 64px; height: 64px; }
		.book { grid-column: 2; justify-self: start; }
	}
</style>
