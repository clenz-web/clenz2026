---
import { Image } from "emdash/ui";
import { pathFor, type Lang } from "../i18n";
interface Props {
	lang: Lang;
	tiles: { slug: string; title: string; text?: string | null; image?: any }[];
}
const { lang, tiles } = Astro.props;
---

<ul class="tiles">
	{tiles.map((tile) => (
		<li>
			<a class="tile" href={pathFor(lang, tile.slug)}>
				<div class="media">{tile.image && <Image image={tile.image} sizes="(max-width: 640px) 100vw, 33vw" />}</div>
				<h3>{tile.title}</h3>
				{tile.text && <p>{tile.text}</p>}
			</a>
		</li>
	))}
</ul>

<style>
	.tiles {
		list-style: none;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: clamp(1rem, 2.5vw, 2rem);
	}
	.tile { display: block; text-decoration: none; color: inherit; }
	.media {
		aspect-ratio: 3 / 4;
		border-radius: 160px 160px var(--radius-lg) var(--radius-lg);
		overflow: hidden;
		background: var(--mist);
	}
	.media :global(img) {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: transform 600ms var(--ease);
	}
	.tile:hover .media :global(img) { transform: scale(1.04); }
	h3 { margin-top: 1rem; font-size: var(--step-1); font-weight: 400; color: var(--pine); }
	.tile:hover h3 { text-decoration: underline; text-underline-offset: 4px; }
	p {
		margin-top: 0.3rem;
		color: var(--stone);
		font-size: 0.98rem;
		display: -webkit-box;
		-webkit-line-clamp: 3;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}
	@media (max-width: 960px) { .tiles { grid-template-columns: repeat(2, 1fr); } }
	@media (max-width: 480px) { .media { aspect-ratio: 4 / 3; border-radius: var(--radius-lg); } }
</style>
