---
import { Image } from "emdash/ui";

interface Props {
	eyebrow?: string | null;
	title: string;
	text?: string | null;
	image?: any;
	variant?: "home" | "page";
	price?: string | null;
}
const { eyebrow, title, text, image, variant = "page", price } = Astro.props;
---

{variant === "home" ? (
	<section class="hero-home">
		{image && <Image image={image} class="hero-home-img" priority sizes="100vw" />}
		<div class="hero-home-shade" aria-hidden="true"></div>
		<svg class="ripples" viewBox="0 0 600 600" aria-hidden="true">
			<circle cx="300" cy="300" r="90" />
			<circle cx="300" cy="300" r="170" />
			<circle cx="300" cy="300" r="250" />
		</svg>
		<div class="wrap hero-home-inner">
			{eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
			<h1>{title}</h1>
			{text && <p class="hero-text">{text}</p>}
			<div class="btn-row"><slot /></div>
		</div>
	</section>
) : (
	<section class="hero-page">
		<div class="wrap hero-page-inner">
			<div class="hero-page-copy">
				{eyebrow && <p class="hero-eyebrow">{eyebrow}</p>}
				<h1>{title}</h1>
				{text && <p class="hero-text">{text}</p>}
				{price && <p class="hero-price">{price}</p>}
				<div class="btn-row"><slot /></div>
			</div>
			{image && (
				<div class="hero-page-media">
					<Image image={image} priority sizes="(max-width: 860px) 100vw, 50vw" />
				</div>
			)}
		</div>
	</section>
)}

<style>
	.hero-eyebrow {
		font-size: var(--step--1);
		font-weight: 500;
		color: var(--sage);
		margin-bottom: 1rem;
	}

	/* Home: full-bleed water photo with ripples spreading once on load */
	.hero-home {
		position: relative;
		min-height: min(88vh, 780px);
		display: flex;
		align-items: flex-end;
		overflow: hidden;
		color: var(--white);
		isolation: isolate;
	}
	.hero-home :global(.hero-home-img) {
		position: absolute;
		inset: 0;
		width: 100%;
		height: 100%;
		max-width: none;
		object-fit: cover;
		z-index: -2;
	}
	.hero-home-shade {
		position: absolute;
		inset: 0;
		z-index: -1;
		background: linear-gradient(180deg, rgb(30 41 37 / 0.05) 30%, rgb(30 41 37 / 0.72) 100%);
	}
	.ripples {
		position: absolute;
		width: min(70vw, 720px);
		right: -12%;
		top: -10%;
		fill: none;
		stroke: rgb(255 255 255 / 0.55);
		stroke-width: 1.2;
		z-index: -1;
	}
	.ripples circle {
		transform-origin: 300px 300px;
		animation: ripple 2.8s var(--ease) both;
	}
	.ripples circle:nth-child(2) { animation-delay: 0.25s; }
	.ripples circle:nth-child(3) { animation-delay: 0.5s; }
	@keyframes ripple {
		from { transform: scale(0.4); opacity: 0; }
		40% { opacity: 1; }
		to { transform: scale(1); opacity: 0.8; }
	}
	.hero-home-inner {
		width: 100%;
		padding-block: clamp(3rem, 9vw, 6rem);
	}
	.hero-home .hero-eyebrow { color: var(--white); opacity: 0.85; }
	.hero-home h1 {
		font-size: var(--step-4);
		font-weight: 300;
		letter-spacing: -0.035em;
		line-height: 0.98;
		max-width: 12ch;
	}
	.hero-home .hero-text {
		margin-top: 1.25rem;
		max-width: 38rem;
		font-size: var(--step-1);
		font-weight: 300;
		line-height: 1.45;
	}
	.hero-home .btn-row { margin-top: 2rem; }

	/* Inner pages: copy beside a rounded photo */
	.hero-page { padding-block: clamp(2.5rem, 6vw, 5rem) var(--section); }
	.hero-page-inner {
		display: grid;
		grid-template-columns: 1fr 1fr;
		gap: clamp(2rem, 5vw, 4.5rem);
		align-items: center;
	}
	.hero-page h1 {
		font-size: clamp(2.3rem, 5vw, 4rem);
		font-weight: 300;
		letter-spacing: -0.03em;
		color: var(--pine);
	}
	.hero-page .hero-text {
		margin-top: 1.25rem;
		font-size: var(--step-1);
		font-weight: 300;
		color: var(--stone);
		max-width: 34rem;
		line-height: 1.5;
	}
	.hero-price {
		margin-top: 1.25rem;
		font-weight: 500;
		color: var(--pine);
	}
	.hero-page .btn-row { margin-top: 2rem; }
	.hero-page-media {
		border-radius: var(--radius-lg) var(--radius-lg) var(--radius-lg) 120px;
		overflow: hidden;
		aspect-ratio: 5 / 4;
		background: var(--mist);
	}
	.hero-page-media :global(img) { width: 100%; height: 100%; object-fit: cover; }

	@media (max-width: 860px) {
		.hero-page-inner { grid-template-columns: 1fr; }
		.hero-page-media { order: -1; aspect-ratio: 16 / 10; }
	}
</style>
