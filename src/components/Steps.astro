---
interface Props {
	items: { title: string; text?: string | null }[];
}
const { items } = Astro.props;
---

<ol class="steps">
	{items.map((s, i) => (
		<li>
			<span class="num" aria-hidden="true">{i + 1}</span>
			<div>
				<h3>{s.title}</h3>
				{s.text && String(s.text).split(/\n+/).filter(Boolean).map((p) => <p>{p}</p>)}
			</div>
		</li>
	))}
</ol>

<style>
	.steps { list-style: none; display: grid; grid-template-columns: repeat(2, 1fr); gap: 2.5rem 3rem; counter-reset: s; }
	li { display: grid; grid-template-columns: 3rem 1fr; gap: 1rem; }
	.num {
		width: 3rem;
		height: 3rem;
		border-radius: 50%;
		border: 1.5px solid var(--sage);
		display: grid;
		place-items: center;
		color: var(--pine);
		font-weight: 500;
	}
	h3 { font-size: var(--step-1); font-weight: 400; color: var(--pine); margin-top: 0.4rem; }
	p { margin-top: 0.6rem; color: var(--ink); max-width: 34rem; }
	@media (max-width: 760px) { .steps { grid-template-columns: 1fr; } }
</style>
