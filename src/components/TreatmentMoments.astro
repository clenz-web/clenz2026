---
/**
 * TreatmentMoments — the massage page hero + treatment list as one pinned,
 * smooth-scrolled sequence. Each treatment photo dissolves in as a framed card
 * while it opens to full-bleed; the previous photo dissolves away underneath.
 * Treatment data (title, summary, prices, image) comes from the CMS.
 */
import { Image } from "emdash/ui";
import { SITE } from "../site";

interface Props {
	treatments: any[];
	eyebrow?: string | null;
	headline: string;
	headlineItalic: string;
	intro: string;
	bookLabel: string;
}

const { treatments, eyebrow, headline, headlineItalic, intro, bookLabel } = Astro.props;
const n = treatments.length;
const pad = (i: number) => String(i + 1).padStart(2, "0");
// Calm greens drawn from the Clenz palette; one per treatment, repeating.
const ACCENTS = ["#9fbdac", "#7fa892", "#b6cdb9", "#6f9a83", "#a9c4a0", "#8fb3a6", "#c3d6c4", "#7c9f8c", "#a3c0b0"];
const prices = (p: unknown) =>
	String(p ?? "")
		.split("|")
		.map((s) => s.trim())
		.filter(Boolean);
---

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
	rel="stylesheet"
	href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..400;1,9..144,300..400&display=swap"
/>

<section class="tm" data-tm style={`--n:${n}; --accent:${ACCENTS[0]}`} aria-label={headline + " " + headlineItalic}>
	<div class="tm-stage">
		<div class="tm-bg" aria-hidden="true"></div>

		{
			treatments.map((tr, i) => (
				<div class="tm-m" data-m style={`z-index:${i + 1}`}>
					<div class="tm-clip">
						<div class="tm-img">
							{tr.data.image && <Image image={tr.data.image} sizes="100vw" />}
						</div>
					</div>
				</div>
			))
		}

		<div class="tm-veil" aria-hidden="true"></div>

		<div class="tm-labels" aria-hidden="true">
			{
				treatments.map((tr, i) => (
					<div class="tm-label" data-label>
						<span class="tm-num">{pad(i)} / {pad(n - 1)}</span>
						<span class="tm-dot" style={`background:${ACCENTS[i % ACCENTS.length]}`} />
					</div>
				))
			}
		</div>

		<div class="tm-cards">
			{
				treatments.map((tr, i) => (
					<article class="tm-card" data-card>
						<h2>{tr.data.title}</h2>
						{tr.data.summary && <p>{tr.data.summary}</p>}
						<ul>
							{prices(tr.data.prices).map((p) => (
								<li>{p}</li>
							))}
						</ul>
						<a href={SITE.bookingUrl} target="_blank" rel="noopener" tabindex="-1" data-card-link>
							{bookLabel} <span aria-hidden="true">→</span>
							<span class="visually-hidden">: {tr.data.title}</span>
						</a>
					</article>
				))
			}
		</div>

		<div class="tm-hero">
			{eyebrow && <p class="tm-eyebrow">{eyebrow}</p>}
			<h1>
				{headline}
				<br />
				<em>{headlineItalic}</em>
			</h1>
			<p class="tm-intro">{intro}</p>
			<a class="btn btn--primary" href={SITE.bookingUrl} target="_blank" rel="noopener">{bookLabel}</a>
		</div>

		<div class="tm-progress" aria-hidden="true"><span data-progress></span></div>
	</div>

	<!-- Accessible, non-animated list of the same treatments for screen readers -->
	<ul class="visually-hidden">
		{
			treatments.map((tr) => (
				<li>
					{tr.data.title}. {tr.data.summary} {prices(tr.data.prices).join(", ")}.{" "}
					<a href={SITE.bookingUrl} target="_blank" rel="noopener">
						{bookLabel}: {tr.data.title}
					</a>
				</li>
			))
		}
	</ul>
</section>

<style>
	.tm {
		position: relative;
		height: calc((var(--n) * 62 + 100) * 1svh);
		background: var(--water);
	}
	.tm-stage {
		position: sticky;
		top: 0;
		height: 100svh;
		overflow: hidden;
		isolation: isolate;
	}
	.tm-bg {
		position: absolute;
		inset: -10%;
		z-index: 0;
		background:
			radial-gradient(55% 50% at 14% 32%, color-mix(in oklab, var(--accent) 55%, transparent), transparent 72%),
			radial-gradient(50% 55% at 90% 88%, color-mix(in oklab, var(--accent) 35%, var(--mist)), transparent 72%),
			var(--water);
		transition: background 1.2s ease;
	}

	.tm-m {
		position: absolute;
		inset: 0;
		opacity: 0;
		will-change: opacity;
	}
	.tm-clip {
		position: absolute;
		inset: 0;
		clip-path: inset(var(--t, 20vh) var(--r, 20vw) var(--b, 20vh) var(--l, 44vw) round var(--rad, 28px));
		will-change: clip-path;
	}
	.tm-img {
		position: absolute;
		inset: 0;
		transform: scale(var(--s, 1.08));
		will-change: transform;
		background: var(--mist);
	}
	.tm-img :global(img) {
		position: absolute !important;
		inset: 0 !important;
		width: 100% !important;
		height: 100% !important;
		max-width: none !important;
		object-fit: cover !important;
	}

	/* soft light wash bottom-left so the green type stays readable over photos */
	.tm-veil {
		position: absolute;
		inset: 0;
		z-index: 40;
		pointer-events: none;
		background:
			linear-gradient(to top, rgb(244 248 246 / 0.92), rgb(244 248 246 / 0) 48%),
			linear-gradient(to right, rgb(244 248 246 / 0.78), rgb(244 248 246 / 0) 52%);
	}

	.tm-labels,
	.tm-cards,
	.tm-hero,
	.tm-progress {
		z-index: 45;
	}

	.tm-labels {
		position: absolute;
		left: var(--gutter);
		top: 46%;
	}
	.tm-label {
		position: absolute;
		display: grid;
		gap: 10px;
		white-space: nowrap;
		opacity: 0;
		transform: translateY(8px);
		transition: opacity 0.5s ease, transform 0.5s ease;
	}
	.tm-label.is-active {
		opacity: 1;
		transform: none;
	}
	.tm-num {
		font-size: 0.75rem;
		letter-spacing: 0.16em;
		color: var(--stone);
		font-variant-numeric: tabular-nums;
	}
	.tm-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		box-shadow: 0 0 0 4px rgb(255 255 255 / 0.6);
	}

	.tm-cards {
		position: absolute;
		left: var(--card-x, 64vw);
		top: var(--card-y, 60%);
		width: min(300px, 80vw);
	}
	.tm-card {
		position: absolute;
		inset: 0 auto auto 0;
		width: 100%;
		padding: 1.1rem 1.25rem 1.2rem;
		border-radius: 18px;
		background: rgb(255 255 255 / 0.78);
		backdrop-filter: blur(14px);
		-webkit-backdrop-filter: blur(14px);
		color: var(--ink);
		opacity: 0;
		transform: translateY(10px);
		transition: opacity 0.5s ease, transform 0.5s ease;
		pointer-events: none;
	}
	.tm-card.is-active {
		opacity: 1;
		transform: none;
		pointer-events: auto;
	}
	.tm-card h2 {
		font-size: 1.15rem;
		font-weight: 400;
		color: var(--pine);
		line-height: 1.2;
	}
	.tm-card p {
		margin-top: 0.35rem;
		font-size: 0.92rem;
		color: var(--stone);
		line-height: 1.4;
	}
	.tm-card ul {
		list-style: none;
		display: flex;
		flex-wrap: wrap;
		gap: 0.35rem;
		margin-top: 0.75rem;
	}
	.tm-card li {
		font-size: 0.8rem;
		padding: 0.2rem 0.65rem;
		border-radius: var(--pill);
		border: 1px solid var(--line);
		background: var(--white);
		font-variant-numeric: tabular-nums;
	}
	.tm-card a {
		display: inline-block;
		margin-top: 0.85rem;
		font-weight: 500;
		font-size: 0.95rem;
		color: var(--pine);
		text-underline-offset: 4px;
	}

	.tm-hero {
		position: absolute;
		left: var(--gutter);
		bottom: clamp(1.5rem, 5vh, 3.5rem);
		max-width: min(560px, 88vw);
	}
	.tm-eyebrow {
		font-size: var(--step--1);
		font-weight: 500;
		color: var(--pine);
		opacity: 0.8;
		margin-bottom: 1rem;
	}
	.tm-hero h1 {
		font-family: "Fraunces", Georgia, serif;
		font-weight: 330;
		font-size: clamp(2.6rem, 6.2vw, 5.6rem);
		letter-spacing: -0.03em;
		line-height: 0.95;
		color: var(--pine);
	}
	.tm-hero h1 em {
		font-style: italic;
		color: color-mix(in oklab, var(--accent) 55%, var(--pine));
		transition: color 0.8s ease;
	}
	.tm-intro {
		margin-top: 1.1rem;
		max-width: 28rem;
		font-size: var(--step-1);
		font-weight: 300;
		line-height: 1.45;
		color: var(--ink);
	}
	.tm-hero .btn {
		margin-top: 1.5rem;
	}

	.tm-progress {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		height: 2px;
		background: rgb(47 79 67 / 0.08);
	}
	.tm-progress span {
		display: block;
		height: 100%;
		background: var(--pine);
		transform-origin: 0 50%;
		transform: scaleX(var(--p, 0));
	}

	@media (max-width: 760px) {
		.tm-labels {
			top: 92px;
		}
		.tm-cards {
			left: var(--gutter);
			right: var(--gutter);
			top: 96px;
			width: auto;
			margin-top: 2.2rem;
		}
		.tm-card {
			padding: 0.8rem 1rem;
		}
		.tm-card p {
			display: none;
		}
		.tm-intro {
			font-size: var(--step-0);
		}
	}
</style>

<script>
	const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));
	const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
	const ease = (t: number) => (t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2);
	const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

	/* Lightweight smooth wheel scrolling (no dependency). Touch and keyboard stay native. */
	function smoothWheel() {
		if (reduce || window.matchMedia("(pointer: coarse)").matches) return;
		let target = window.scrollY;
		let current = window.scrollY;
		let running = false;
		const max = () => document.documentElement.scrollHeight - window.innerHeight;
		const step = () => {
			current = lerp(current, target, 0.1);
			if (Math.abs(target - current) < 0.5) {
				current = target;
				running = false;
			}
			window.scrollTo(0, current);
			if (running) requestAnimationFrame(step);
		};
		window.addEventListener(
			"wheel",
			(e) => {
				if (e.ctrlKey) return; // pinch-zoom
				e.preventDefault();
				if (!running) current = target = window.scrollY;
				const delta = e.deltaMode === 1 ? e.deltaY * 32 : e.deltaY;
				target = clamp(target + delta * 0.9, 0, max());
				if (!running) {
					running = true;
					requestAnimationFrame(step);
				}
			},
			{ passive: false },
		);
		// keep in sync with scrollbar, keyboard and anchor jumps
		window.addEventListener("scroll", () => {
			if (!running) current = target = window.scrollY;
		}, { passive: true });
	}

	function init(section: HTMLElement) {
		const layers = [...section.querySelectorAll<HTMLElement>("[data-m]")];
		const labels = [...section.querySelectorAll<HTMLElement>("[data-label]")];
		const cards = [...section.querySelectorAll<HTMLElement>("[data-card]")];
		const links = [...section.querySelectorAll<HTMLElement>("[data-card-link]")];
		const bar = section.querySelector<HTMLElement>("[data-progress]");
		const accents = [...section.querySelectorAll<HTMLElement>(".tm-dot")].map((d) => d.style.background);
		const n = layers.length;
		if (!n) return;

		let vw = 0, vh = 0, lastY = -1, lastActive = -1;
		let card = { t: 0, r: 0, b: 0, l: 0 };

		function measure() {
			const header = document.querySelector<HTMLElement>(".site-header");
			section.style.marginTop = header ? `-${header.offsetHeight}px` : "";
			vw = window.innerWidth;
			vh = window.innerHeight;
			const mobile = vw < 760;
			const ratio = 0.9; // close to square, so the landscape treatment photos keep their subject
			let w = mobile ? vw * 0.7 : Math.min(vw * 0.36, 620);
			let h = w * ratio;
			const maxH = vh * (mobile ? 0.4 : 0.6);
			if (h > maxH) { h = maxH; w = h / ratio; }
			const cx = mobile ? vw * 0.62 : vw * 0.6;
			const cy = mobile ? vh * 0.5 : vh * 0.48;
			card = { t: cy - h / 2, b: vh - (cy + h / 2), l: cx - w / 2, r: vw - (cx + w / 2) };
			if (!mobile) {
				section.style.setProperty("--card-x", `${Math.min(cx + w * 0.32, vw - 330)}px`);
				section.style.setProperty("--card-y", `${cy + h * 0.12}px`);
			}
			lastY = -1;
		}

		// Timeline per treatment (t = f - i): the dissolve and the reveal overlap.
		// The dissolve runs across almost the whole slide: the next photo starts fading in
		// as soon as the current one is full-bleed, and the current one fades out over the same span.
		const FADE = 0.62, IN_END = 0.18, Z1 = 0.4, OUT_END = 1.18, LABEL_SHIFT = 0.25;
		const smooth = (t: number) => 0.5 - 0.5 * Math.cos(Math.PI * clamp(t)); // gentle ease-in-out for opacity

		function render() {
			const rect = section.getBoundingClientRect();
			const travel = section.offsetHeight - vh;
			const p = clamp(-rect.top / travel);
			const f = p * n;

			layers.forEach((el, i) => {
				const t = f - i;
				const clip = el.firstElementChild as HTMLElement;
				let opacity = 0, zoom = 0, enter = 1, dim = 0;

				if (i === 0 && t < 0) {
					opacity = 1;
				} else if (t >= -FADE && t <= OUT_END) {
					const zStart = i === 0 ? 0 : -FADE;
					zoom = ease(clamp((t - zStart) / (Z1 - zStart)));
					enter = i === 0 ? 1 : smooth((t + FADE) / (FADE + IN_END));
					dim = i === n - 1 ? 0 : smooth((t - (1 - FADE)) / (OUT_END - (1 - FADE)));
					opacity = Math.min(enter, 1 - dim);
				}

				el.style.opacity = String(opacity);
				el.style.visibility = opacity <= 0.001 ? "hidden" : "visible";
				if (opacity <= 0.001) return;

				const k = 1 - zoom;
				clip.style.setProperty("--t", `${card.t * k}px`);
				clip.style.setProperty("--r", `${card.r * k}px`);
				clip.style.setProperty("--b", `${card.b * k}px`);
				clip.style.setProperty("--l", `${card.l * k}px`);
				clip.style.setProperty("--rad", `${28 * k}px`);
				const img = clip.firstElementChild as HTMLElement;
				img.style.setProperty("--s", (lerp(1.08, 1.02, zoom) + dim * 0.05 + (1 - enter) * 0.08).toFixed(4));
			});

			const active = clamp(Math.floor(f + LABEL_SHIFT), 0, n - 1);
			if (active !== lastActive) {
				labels.forEach((l, i) => l.classList.toggle("is-active", i === active));
				cards.forEach((c, i) => c.classList.toggle("is-active", i === active));
				links.forEach((a, i) => a.setAttribute("tabindex", i === active ? "0" : "-1"));
				if (accents[active]) section.style.setProperty("--accent", accents[active]);
				lastActive = active;
			}
			bar?.style.setProperty("--p", p.toFixed(4));
		}

		function loop() {
			const y = window.scrollY;
			if (y !== lastY) { lastY = y; render(); }
			requestAnimationFrame(loop);
		}

		measure();
		render();
		window.addEventListener("resize", measure, { passive: true });
		requestAnimationFrame(loop);
	}

	const sections = document.querySelectorAll<HTMLElement>("[data-tm]");
	if (sections.length) {
		smoothWheel();
		sections.forEach(init);
	}
</script>
